#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "stretch"
    doc = """Generated from Composed Stage of root layer /tmp/tmpkhsgent6/stretch.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_stretch_b7s_ly_i/usdex_stretch/stretch.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_stretch_b7s_ly_i/temp_stretch/stretch.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "stretch"
{
    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["PhysxArticulationAPI"]
        )
        {
            # PATCH (isaac-social-nav): URDF import left PhysX self-collision on; tire
            # spheres then jam against the chassis collider and kill traction.
            bool physxArticulation:enabledSelfCollisions = 0
        }
    }

    over "Physics"
    {
        over "joint_right_wheel" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            # PATCH (isaac-social-nav): URDF importer copied damping/friction (~10) which
            # locks the wheels under DifferentialController. Use near-zero joint friction
            # so /cmd_vel can drive; tire–ground friction still comes from collision materials.
            float physxJoint:jointFriction = 0.0
            # PATCH (isaac-social-nav): stronger velocity drive for ~20 kg base.
            # ORIGINALLY: drive damping = URDF 21.75, no maxForce.
            float drive:angular:physics:damping = 1000
            float drive:angular:physics:maxForce = 10000
            float drive:angular:physics:stiffness = 0
        }

        over "joint_left_wheel" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:jointFriction = 0.0
            float drive:angular:physics:damping = 1000
            float drive:angular:physics:maxForce = 10000
            float drive:angular:physics:stiffness = 0
        }

        over "joint_lift" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 57.29578
        }

        over "joint_arm_l3" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 57.29578
        }

        over "joint_arm_l2" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 57.29578
        }

        over "joint_arm_l1" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 57.29578
        }

        over "joint_arm_l0" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 57.29578
        }

        over "joint_wrist_yaw" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 57.29578
        }

        over "joint_head_pan" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 57.29578
        }

        over "joint_head_tilt" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 57.29578
        }

        over "joint_wrist_pitch" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 57.29578
        }

        over "joint_wrist_roll" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 57.29578
        }

        over "joint_gripper_finger_right" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "joint_gripper_finger_left" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }
    }
}

