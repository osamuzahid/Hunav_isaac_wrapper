        prepend references = @./geometries.usd@</Geometries/link_head_pan_collision>
    )
    {
        over "link_head_pan_collision" (
            apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            # PATCH (isaac-social-nav): disable URDF convexHull mesh colliders — they
            # sled on the floor / jam the diff-drive. Rolling + walls use sphere/box
            # prims in base.usda instead.
            bool physics:collisionEnabled = 0
            token physics:approximation = "convexHull"
            token purpose = "guide"
        }
    }

